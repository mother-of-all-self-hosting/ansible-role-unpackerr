TZ={{ unpackerr_environment_variables_tz }}

UN_DEBUG={{ unpackerr_environment_variables_un_debug | to_json }}

{#
An empty listen address is what turns the HTTP server off, so it is always passed.
#}
UN_WEBSERVER_LISTEN_ADDR={{ unpackerr_environment_variables_un_webserver_listen_addr }}
UN_WEBSERVER_URLBASE={{ unpackerr_environment_variables_un_webserver_urlbase }}

{#
Unpackerr lets a present `UN_WEBSERVER_UI_PASSWORD` override the hash stored in its
config file, even when it is empty: it then ignores the stored password and generates
a new temporary one on every start, without saving it. So the variable is only passed
when there is a password to pass.
#}
{% if unpackerr_environment_variables_un_webserver_ui_password %}
UN_WEBSERVER_UI_PASSWORD={{ unpackerr_environment_variables_un_webserver_ui_password }}
{% endif %}

{% if unpackerr_environment_variables_un_webserver_upstreams | length > 0 %}
UN_WEBSERVER_UPSTREAMS={{ unpackerr_environment_variables_un_webserver_upstreams | join(',') }}
{% endif %}

{#
Everything passed here overrides the config file Unpackerr keeps in /config,
and is shown as locked in the web UI.
#}
{{ unpackerr_environment_variables_additional_variables }}
